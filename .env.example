# ─── Live Junk Free website: environment variables ───────────────────────────
# Copy to .env.local for local development. Set the same values in Vercel →
# Project → Settings → Environment Variables for deployments.

# Public site URL (canonical URLs, sitemaps).
NEXT_PUBLIC_SITE_URL=https://livejunkfree.ca

# Client preview mode: shows the preview toolbar + /review/ and makes every page noindex.
# Set to false (or remove) for the real launch.
NEXT_PUBLIC_REVIEW_MODE=true

# Which phase is built (1, 2 or 3). URLs from later phases are served by the old site.
BUILD_PHASE=1

# Old WordPress site for the transition fallback (src/proxy.ts). Once DNS points
# livejunkfree.ca at Vercel this must be a DIFFERENT hostname that still serves
# WordPress, e.g. https://old.livejunkfree.ca or the Hostinger temporary domain.
# Leave empty before the DNS switch: previews then fall back to https://livejunkfree.ca.
OLD_SITE_ORIGIN=

# Supabase (leads). URL + anon key are public (browser uploads photos with
# one-time signed URLs); the service role key is server-only — never expose it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local only (not needed on Vercel): Postgres URI used to apply supabase/migrations/.
# Use the Session pooler address (IPv4): postgresql://postgres.<ref>:<password>@aws-1-ca-central-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Email notifications for new leads (Resend). The "from" domain must be verified in Resend.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=info@livejunkfree.ca
LEAD_FROM_EMAIL=Live Junk Free website <leads@livejunkfree.ca>

# Tracking.
NEXT_PUBLIC_GTM_ID=GTM-5GPZ262Z
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-16519215726

# Cloudflare Turnstile bot check on forms (optional until set; honeypot + rate limit always on).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: live Google Places reviews (not used: reviews come from the Trustindex snapshot).
GOOGLE_PLACES_API_KEY=
