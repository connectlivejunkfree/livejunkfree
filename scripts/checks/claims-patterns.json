    "\\bready for (occupants|an installer|the next tenant|new tenants|the next owner)\\b",
    "\\bleft ready\\b",
    "\\bworry[- ]free\\b",
    "\\brisk[- ]free\\b",
    "\\bwithout (causing |any )*(damage|harm|a scratch)\\b",
    "\\bno job (is )?too (big|small|tricky|large|hard)\\b",
    "\\bnever (damage|scratch)\\b",
    "\\bfloor runners?\\b",
    "\\b(specialized |special |protective )?padding\\b",
    "\\bfloor (coverings?|protection)\\b",
    "\\bprotective (blankets|coverings?)\\b",
    "\\bcorner guards?\\b",
    "\\b(baby )?grand pianos?\\b",
