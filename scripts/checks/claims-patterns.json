{
 "_readme": [
  "Claims the 18 Nov independent QA (and the 18 Nov answers) rule out. Each category lists case-insensitive regexes ('patterns') and an allow-list ('allow') of approved phrasings.",
  "A pattern can be a string or {\"re\": \"…\", \"flags\": \"\"} for a case-sensitive one.",
  "The check works sentence by sentence. A hit is ALLOWED only if the same sentence matches an allow entry (each has a reason) or contains an approved sentence from content/business-facts.json (status confirmed). Allowed hits are still written to the report with their reason: nothing is silently ignored.",
  "Locations checked: visible text, <title>, meta description, image alt text and every JSON-LD string."
 ],
 "globalAllow": [
  {
   "re": "\\b(we|live junk free)\\s+(don['’]t|do not|can['’]t|cannot|won['’]t|never)\\s+(offer|provide|promise|guarantee|take|accept|handle|do|perform|remove|disconnect|obtain|arrange)\\b",
   "reason": "explicit disclaimer of a service we don't offer"
  },
  {
   "re": "\\b(isn['’]t|is not|aren['’]t|are not|not)\\s+(guaranteed|included|promised|offered|available)\\b",
   "reason": "explicit non-promise"
  }
 ],
 "categories": {
